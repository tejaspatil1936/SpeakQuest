# Local configuration. Copy to .env (gitignored). Never commit real values.
#
# --- AWS credentials (used by make plan/up/deploy/seed/down and, if set, by
# --- the local server for Bedrock coaching). Prefer an AWS profile instead.
# AWS_PROFILE=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Vercel (only for enable_frontend = true); keep it in your shell.
# VERCEL_API_TOKEN=

# --- Local runtime (speakquest-local); defaults shown.
# SPEAKQUEST_LOCAL_DIR=.local
# SPEAKQUEST_LOCAL_BASE_URL=http://localhost:8787
# SPEAKQUEST_LOCAL_ALIGNER=vosk            # or faster-whisper
# SPEAKQUEST_ALLOWED_ORIGINS=http://localhost:5173
# SPEAKQUEST_MODEL_DIR=.models
# SPEAKQUEST_WHISPER_MODEL=base.en
# SPEAKQUEST_BEDROCK=1                     # 0 = always use template coaching
# SPEAKQUEST_BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
