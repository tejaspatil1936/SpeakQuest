          "type": "integer"
        }
      },
      "required": [
        "text",
        "tokens",
        "phrase_count"
      ],
      "title": "ScriptInfo",
      "type": "object"
    },
    "ScriptToken": {
      "additionalProperties": false,
      "properties": {
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "norm": {
          "title": "Norm",
          "type": "string"
