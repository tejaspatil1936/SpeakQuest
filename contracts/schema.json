    "Pause": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "number"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "number"
        },
        "ms": {
          "minimum": 0,
          "title": "Ms",
          "type": "integer"
        },
        "before_word": {
          "description": "Index of the word that follows the pause",
          "minimum": 0,
          "title": "Before Word",
          "type": "integer"
        }
      },
      "required": [
        "start",
        "end",
        "ms",
        "before_word"
      ],
      "title": "Pause",
      "type": "object"
    },
    "Penalty": {
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "dimension": {
          "enum": [
            "pace",
            "pauses",
            "pitch",
            "volume",
            "accuracy"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "points": {
          "minimum": 0,
          "title": "Points",
          "type": "number"
        }
      },
      "required": [
        "finding_id",
        "dimension",
        "points"
      ],
      "title": "Penalty",
      "type": "object"
    },
    "PhraseStat": {
      "additionalProperties": false,
      "properties": {
        "phrase": {
          "minimum": 0,
          "title": "Phrase",
          "type": "integer"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "number"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "number"
        },
        "pitch_sd_st": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pitch Sd St"
        }
      },
      "required": [
        "phrase",
        "start",
        "end"
      ],
      "title": "PhraseStat",
      "type": "object"
    },
    "ProgressResponse": {
      "additionalProperties": false,
      "properties": {
        "xp": {
          "description": "Air time in seconds of successfully analysed takes",
          "minimum": 0,
          "title": "Xp",
          "type": "integer"
        },
        "level": {
          "$ref": "#/$defs/Level"
        },
        "badges": {
          "items": {
            "$ref": "#/$defs/Badge"
          },
          "title": "Badges",
          "type": "array"
        },
        "takes": {
          "items": {
            "$ref": "#/$defs/TakeSummary"
          },
          "title": "Takes",
          "type": "array"
        }
      },
      "required": [
        "xp",
        "level",
        "badges",
        "takes"
      ],
      "title": "ProgressResponse",
      "type": "object"
    },
    "Scores": {
      "additionalProperties": false,
      "properties": {
        "pace": {
          "maximum": 100,
          "minimum": 0,
          "title": "Pace",
          "type": "integer"
        },
        "pauses": {
          "maximum": 100,
          "minimum": 0,
          "title": "Pauses",
          "type": "integer"
        },
        "pitch": {
          "maximum": 100,
          "minimum": 0,
          "title": "Pitch",
          "type": "integer"
        },
        "volume": {
          "maximum": 100,
          "minimum": 0,
          "title": "Volume",
          "type": "integer"
        },
        "accuracy": {
          "maximum": 100,
          "minimum": 0,
          "title": "Accuracy",
          "type": "integer"
        },
        "overall": {
          "maximum": 100,
          "minimum": 0,
          "title": "Overall",
          "type": "integer"
        }
      },
      "required": [
        "pace",
        "pauses",
        "pitch",
        "volume",
        "accuracy",
        "overall"
      ],
      "title": "Scores",
      "type": "object"
    },
    "ScriptInfo": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "tokens": {
          "items": {
            "$ref": "#/$defs/ScriptToken"
