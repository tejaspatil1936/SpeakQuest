    "CreateAnalysisRequest": {
      "$ref": "#/$defs/CreateAnalysisRequest"
    },
    "CreateAnalysisResponse": {
      "$ref": "#/$defs/CreateAnalysisResponse"
    },
    "AnalysisStatusResponse": {
      "$ref": "#/$defs/AnalysisStatusResponse"
    },
    "AnalysisResultResponse": {
