      },
      "required": [
        "op"
      ],
      "title": "AlignOp",
      "type": "object"
    },
    "AnalysisResult": {
      "additionalProperties": false,
      "description": "``results/<analysisId>/result.json`` \u2014 everything the playback screen renders.",
      "properties": {
        "schema_version": {
          "const": "1",
          "default": "1",
          "title": "Schema Version",
          "type": "string"
        },
        "analysis_id": {
          "title": "Analysis Id",
          "type": "string"
        },
        "challenge_id": {
          "title": "Challenge Id",
          "type": "string"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "versions": {
          "$ref": "#/$defs/Versions"
        },
        "script": {
          "$ref": "#/$defs/ScriptInfo"
        },
        "take": {
          "$ref": "#/$defs/TakeAnalysis"
        },
        "reference": {
          "$ref": "#/$defs/TakeAnalysis"
        },
        "alignment": {
          "items": {
            "$ref": "#/$defs/AlignOp"
          },
          "title": "Alignment",
          "type": "array"
        },
        "findings": {
          "items": {
            "$ref": "#/$defs/Finding"
          },
          "title": "Findings",
          "type": "array"
        },
        "penalties": {
          "items": {
            "$ref": "#/$defs/Penalty"
          },
          "title": "Penalties",
          "type": "array"
        },
        "scores": {
          "$ref": "#/$defs/Scores"
        },
        "coaching": {
          "anyOf": [
            {
              "$ref": "#/$defs/Coaching"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        }
      },
      "required": [
        "analysis_id",
        "challenge_id",
        "created_at",
        "versions",
        "script",
        "take",
        "reference",
        "alignment",
        "findings",
        "penalties",
        "scores"
      ],
      "title": "AnalysisResult",
      "type": "object"
    },
    "AnalysisResultResponse": {
      "additionalProperties": false,
      "properties": {
        "resultUrl": {
          "title": "Resulturl",
          "type": "string"
        },
        "audioUrl": {
          "title": "Audiourl",
          "type": "string"
        },
        "referenceAudioUrl": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Referenceaudiourl"
        },
        "expiresIn": {
          "title": "Expiresin",
          "type": "integer"
        }
      },
      "required": [
        "resultUrl",
        "audioUrl",
        "expiresIn"
      ],
      "title": "AnalysisResultResponse",
      "type": "object"
    },
    "AnalysisStatusResponse": {
      "additionalProperties": false,
      "properties": {
        "analysisId": {
          "title": "Analysisid",
          "type": "string"
        },
        "challengeId": {
          "title": "Challengeid",
          "type": "string"
        },
        "status": {
          "enum": [
            "QUEUED",
            "RUNNING",
            "DONE",
            "FAILED"
          ],
          "title": "Status",
          "type": "string"
        },
        "stage": {
          "enum": [
            "QUEUED",
            "NORMALIZE",
            "TRANSCRIBE",
            "ANALYZE",
            "EXPLAIN",
            "PERSIST",
            "DONE"
          ],
          "title": "Stage",
          "type": "string"
        },
        "createdAt": {
          "title": "Createdat",
          "type": "string"
        },
        "updatedAt": {
          "title": "Updatedat",
          "type": "string"
        },
        "summary": {
          "anyOf": [
            {
              "$ref": "#/$defs/AnalysisSummary"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorInfo"
            },
            {
              "type": "null"
            }
          ],
          "default": null
