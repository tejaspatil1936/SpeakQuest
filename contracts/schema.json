      "required": [
        "id",
        "title",
        "script",
        "difficulty",
        "flaw_targets",
        "cue"
      ],
      "title": "Challenge",
      "type": "object"
    },
    "ChallengeList": {
      "additionalProperties": false,
      "properties": {
        "challenges": {
          "items": {
            "$ref": "#/$defs/Challenge"
          },
          "title": "Challenges",
          "type": "array"
        }
      },
      "required": [
        "challenges"
      ],
      "title": "ChallengeList",
      "type": "object"
    },
    "Coaching": {
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "bedrock",
            "template"
          ],
          "title": "Source",
          "type": "string"
        },
        "model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Id"
        },
        "items": {
          "items": {
            "$ref": "#/$defs/CoachingItem"
          },
          "title": "Items",
          "type": "array"
        },
        "attempts": {
          "minimum": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "rejections": {
          "description": "Validator messages from rejected model outputs",
          "items": {
            "type": "string"
          },
          "title": "Rejections",
          "type": "array"
        }
      },
      "required": [
        "source",
        "items",
        "attempts"
      ],
      "title": "Coaching",
      "type": "object"
    },
    "CoachingItem": {
      "additionalProperties": false,
      "properties": {
        "finding_id": {
          "title": "Finding Id",
          "type": "string"
        },
        "headline": {
          "maxLength": 160,
          "minLength": 1,
          "title": "Headline",
          "type": "string"
        },
        "why": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Why",
          "type": "string"
        },
        "drill": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Drill",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "headline",
        "why",
        "drill"
      ],
      "title": "CoachingItem",
      "type": "object"
    },
    "CreateAnalysisRequest": {
      "additionalProperties": false,
      "properties": {
        "challengeId": {
          "pattern": "^[a-z0-9-]{3,48}$",
          "title": "Challengeid",
          "type": "string"
        },
        "key": {
          "maxLength": 256,
          "minLength": 1,
          "title": "Key",
          "type": "string"
        },
        "durationS": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Durations"
        }
      },
      "required": [
        "challengeId",
        "key"
      ],
      "title": "CreateAnalysisRequest",
      "type": "object"
    },
    "CreateAnalysisResponse": {
      "additionalProperties": false,
      "properties": {
        "analysisId": {
          "title": "Analysisid",
          "type": "string"
        }
      },
      "required": [
        "analysisId"
      ],
      "title": "CreateAnalysisResponse",
      "type": "object"
    },
    "CreateUploadRequest": {
      "additionalProperties": false,
      "properties": {
        "challengeId": {
          "pattern": "^[a-z0-9-]{3,48}$",
          "title": "Challengeid",
          "type": "string"
        },
        "contentType": {
          "title": "Contenttype",
          "type": "string"
        },
        "bytes": {
          "exclusiveMinimum": 0,
          "title": "Bytes",
          "type": "integer"
        }
      },
      "required": [
        "challengeId",
        "contentType",
        "bytes"
      ],
      "title": "CreateUploadRequest",
      "type": "object"
    },
    "CreateUploadResponse": {
      "additionalProperties": false,
      "properties": {
        "uploadUrl": {
          "title": "Uploadurl",
          "type": "string"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "method": {
          "const": "PUT",
          "default": "PUT",
          "title": "Method",
          "type": "string"
        },
        "headers": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Headers",
          "type": "object"
        },
        "expiresIn": {
          "title": "Expiresin",
          "type": "integer"
        }
      },
      "required": [
        "uploadUrl",
        "key",
        "headers",
        "expiresIn"
      ],
      "title": "CreateUploadResponse",
      "type": "object"
    },
    "ErrorInfo": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "stage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stage"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ErrorInfo",
      "type": "object"
    },
    "ErrorResponse": {
      "additionalProperties": false,
      "properties": {
        "error": {
          "$ref": "#/$defs/ErrorInfo"
        }
      },
      "required": [
        "error"
      ],
      "title": "ErrorResponse",
      "type": "object"
    },
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^f\\d+$",
          "title": "Id",
          "type": "string"
        },
        "code": {
          "enum": [
            "RUSH",
            "DRAG",
            "HESITATE",
            "MONO",
            "FADE",
            "SKIP",
            "FILLER"
          ],
          "title": "Code",
          "type": "string"
        },
        "dimension": {
          "enum": [
            "pace",
            "pauses",
            "pitch",
            "volume",
            "accuracy"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "start": {
          "minimum": 0,
          "title": "Start",
          "type": "number"
        },
        "end": {
          "minimum": 0,
          "title": "End",
          "type": "number"
        },
        "words": {
          "items": {
            "type": "string"
          },
          "title": "Words",
          "type": "array"
        },
        "evidence": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "integer"
              },
              {
                "type": "string"
              }
            ]
          },
          "title": "Evidence",
          "type": "object"
        },
        "severity": {
          "maximum": 3,
          "minimum": 1,
          "title": "Severity",
          "type": "integer"
        },
        "rubric_version": {
          "title": "Rubric Version",
          "type": "string"
        },
        "script_span": {
          "anyOf": [
            {
              "maxItems": 2,
              "minItems": 2,
              "prefixItems": [
                {
                  "type": "integer"
                },
                {
                  "type": "integer"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Script Span"
        }
      },
      "required": [
        "id",
        "code",
        "dimension",
        "start",
        "end",
        "words",
        "evidence",
        "severity",
        "rubric_version"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Level": {
      "additionalProperties": false,
      "properties": {
        "index": {
          "minimum": 0,
          "title": "Index",
          "type": "integer"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "floor_s": {
          "minimum": 0,
          "title": "Floor S",
          "type": "integer"
        },
        "next_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next Name"
        },
        "next_at_s": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Next At S"
        }
      },
      "required": [
