      },
      "required": [
        "analysisId",
        "challengeId",
        "status",
        "stage",
        "createdAt",
        "updatedAt"
      ],
      "title": "AnalysisStatusResponse",
      "type": "object"
    },
    "AnalysisSummary": {
      "additionalProperties": false,
      "properties": {
        "scores": {
          "$ref": "#/$defs/Scores"
        },
        "findingCount": {
          "title": "Findingcount",
          "type": "integer"
        },
        "codes": {
          "items": {
            "enum": [
              "RUSH",
              "DRAG",
              "HESITATE",
              "MONO",
              "FADE",
              "SKIP",
              "FILLER"
            ],
            "type": "string"
          },
          "title": "Codes",
          "type": "array"
        }
      },
      "required": [
        "scores",
        "findingCount",
        "codes"
      ],
      "title": "AnalysisSummary",
      "type": "object"
    },
    "Badge": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "awarded_at": {
          "title": "Awarded At",
          "type": "string"
        },
        "analysis_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Analysis Id"
        }
      },
      "required": [
        "id",
        "label",
        "awarded_at"
      ],
      "title": "Badge",
      "type": "object"
    },
    "Challenge": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[a-z0-9-]{3,48}$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "script": {
          "title": "Script",
          "type": "string"
        },
        "difficulty": {
          "enum": [
            1,
            2,
            3
          ],
          "title": "Difficulty",
          "type": "integer"
        },
        "flaw_targets": {
          "items": {
            "enum": [
              "RUSH",
              "DRAG",
              "HESITATE",
              "MONO",
              "FADE",
              "SKIP",
              "FILLER"
            ],
            "type": "string"
          },
          "title": "Flaw Targets",
          "type": "array"
        },
        "language": {
          "default": "en-US",
          "title": "Language",
          "type": "string"
        },
        "cue": {
          "description": "One-line director's note shown on the cue card",
          "title": "Cue",
          "type": "string"
        },
        "reference_duration_s": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Duration S"
        },
        "reference_audio_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Audio Url"
        },
        "reference_ready": {
          "default": false,
          "title": "Reference Ready",
          "type": "boolean"
        }
